{
  "_about": [
    "VDF key -> AAPS preference, for the candidate card's 'Show AAPS preference names' (backlog H-004).",
    "Keys are the bare profile keys of a VDF row 'profile <key> <value>' (also the keys of ns_settings.json's",
    "autoisf / smb / activity_monitor / flags / safety sections and of the profile dict ns_profile.profile_at() builds).",
    "Lookup: strip the VDF group ('profile ') and index `keys`; a missing key is unmapped.",
    "Honesty rule: `title` is the wording of the AAPS preference screen (AAPS 3.4.x + autoISF 3.2 build) as the author",
    "knows it in October 2026, or null. A null title is NOT a guess to be filled from the key name: it means the",
    "wording was not verified; the card prints the VDF key instead. `pref_key` is the SharedPreferences key as it",
    "appears in software/aaps_preferences.json (the scrubbed export of 2026-09-07) and is factual where given; null",
    "means the export carries no such key (emulator-only key, hard-coded in AAPS, or derived at run time).",
    "Titles should be cross-checked once against the fork's res/values/strings.xml; note the result in `_verified`."
  ],
  "_verified": {
    "against_strings_xml": false,
    "note": "titles from the author's knowledge of the preference screens, not yet diffed against the autoISF 3.2 strings.xml"
  },
  "_fields": {
    "vdf": "the VDF row group and key, e.g. 'profile autoISF_max'",
    "settings_section": "where the current value lives: a section of ns_settings.json (autoisf, smb, activity_monitor, flags, safety, nightscout), 'profile' (the Nightscout profile store / AAPS profile editor), 'derived' (computed per loop), 'emulator' (emulator-only key)",
    "pref_key": "AAPS SharedPreferences key as in aaps_preferences.json, or null",
    "screen": "the preference screen or editor the setting sits on, or null",
    "title": "the title shown on the phone, or null when not verified",
    "unit": "one of _units, or null",
    "note": "optional; explains a null or a unit trap"
  },
  "_units": {
    "on/off": "boolean switch",
    "factor": "dimensionless multiplier on ISF or a limit",
    "weight": "dimensionless autoISF weight (0 disables the effect)",
    "ratio": "dimensionless share, 0..1",
    "%": "percent",
    "min": "minutes",
    "h": "hours",
    "hour of day": "local hour 0..23",
    "mg/dl": "glucose in mg/dl inside the profile dict (the phone shows the user's unit; ns_settings.json gives mg/dl unless the key name says otherwise)",
    "mmol/L": "glucose in mmol/L (only where the key is kept in the user's unit)",
    "U": "insulin units",
    "U/h": "insulin units per hour",
    "g": "grams of carbohydrate",
    "g/U": "grams per unit (carb ratio)",
    "glucose per U": "ISF: mg/dl per U inside the profile dict, mmol/L per U in the AAPS profile editor",
    "readings": "number of CGM readings",
    "text": "free text / version string"
  },
